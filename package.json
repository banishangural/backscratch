{
  "name": "backscratch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run widget:build && next dev",
    "build": "npm run widget:build && next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "widget:build": "node widget/build.mjs",
    "widget:watch": "node widget/build.mjs --watch",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "bash scripts/setup-dev-db.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

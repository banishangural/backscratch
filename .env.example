# Copy to .env and fill in. Never commit .env.

# --- Core ---
APP_NAME=Backscratch
APP_URL=http://localhost:3000
# Local dev DB created by `npm run db:setup` (dev-only password)
DATABASE_URL=postgresql://backscratch:backscratch_dev@localhost:5432/backscratch?schema=public
# Direct (non-pooled) URL for Prisma migrations. On Neon/Vercel this is set by the integration.
# Leave empty locally; Prisma then uses DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Auth.js (Phase 1) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
# Leave empty in development to print magic links to the server console instead of emailing them
AUTH_RESEND_KEY=
# Testing: Resend's onboarding@resend.dev sender only delivers to your own Resend account email.
# Production: use an address on a domain you verified in Resend.
EMAIL_FROM="Backscratch <onboarding@resend.dev>"
# Comma-separated admin emails
ADMIN_EMAILS=you@example.com

# --- Security ---
# 32 random bytes, base64: openssl rand -base64 32 (Phase 6)
ENCRYPTION_KEY=
# Long random string; cron jobs send it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Tunables ---
MAX_ACTIVE_SWAPS_PER_PRODUCT=5
SWAP_DEFAULT_DAYS=30
SWAP_RENEWAL_REMINDER_DAYS=5
SWAP_REREQUEST_COOLDOWN_DAYS=14
HEARTBEAT_PAUSE_HOURS=72
# Optional minimum monthly visitors from a verified integration to be listed (Phase 6); 0 = no minimum
MARKETPLACE_MIN_MONTHLY_VISITORS=0

# --- Integrations (Phase 6) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
